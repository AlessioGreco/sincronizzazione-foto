<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- "Darkroom": warm charcoal with an amber safelight accent (same keys as palette.light.xaml) -->
  <SolidColorBrush x:Key="B.Bg"          Color="#131416"/>
  <SolidColorBrush x:Key="B.Surface"     Color="#1C1E21"/>
  <SolidColorBrush x:Key="B.SurfaceAlt"  Color="#26292D"/>
  <SolidColorBrush x:Key="B.Border"      Color="#34383D"/>
  <SolidColorBrush x:Key="B.Text"        Color="#ECEAE4"/>
  <SolidColorBrush x:Key="B.Muted"       Color="#9AA0A6"/>
  <SolidColorBrush x:Key="B.Accent"      Color="#FFC233"/>
  <SolidColorBrush x:Key="B.AccentHover" Color="#FFD15C"/>
  <SolidColorBrush x:Key="B.AccentSoft"  Color="#3A2F12"/>
  <SolidColorBrush x:Key="B.AccentInk"   Color="#FFC233"/>
  <SolidColorBrush x:Key="B.OnAccent"    Color="#15181C"/>
  <SolidColorBrush x:Key="B.Danger"      Color="#FF8A80"/>
  <SolidColorBrush x:Key="B.DangerSoft"  Color="#3A2220"/>
  <SolidColorBrush x:Key="B.Success"     Color="#5ED69B"/>
  <SolidColorBrush x:Key="B.SuccessSoft" Color="#1A3328"/>
  <SolidColorBrush x:Key="B.Warn"        Color="#FFC233"/>
  <SolidColorBrush x:Key="B.WarnSoft"    Color="#3A2F12"/>
  <SolidColorBrush x:Key="B.Hover"       Color="#2D3136"/>
  <SolidColorBrush x:Key="B.Film"        Color="#0B0C0E"/>
  <SolidColorBrush x:Key="B.FilmHole"    Color="#26292D"/>
  <SolidColorBrush x:Key="B.FilmFrame"   Color="#2B2F34"/>

  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"                  Color="#1C1E21"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}"              Color="#ECEAE4"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"                 Color="#26292D"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}"             Color="#ECEAE4"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"               Color="#3A2F12"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"           Color="#ECEAE4"/>
</ResourceDictionary>
