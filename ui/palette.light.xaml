<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- "Lightbox": a cool light table, ink-black text, film-yellow accent.
       Yellow is only used as a fill or border (never as text on light backgrounds: no contrast);
       B.AccentInk is the readable amber for text/icons. Keys are used with DynamicResource. -->
  <SolidColorBrush x:Key="B.Bg"          Color="#E8EBEE"/>
  <SolidColorBrush x:Key="B.Surface"     Color="#FFFFFF"/>
  <SolidColorBrush x:Key="B.SurfaceAlt"  Color="#F0F2F4"/>
  <SolidColorBrush x:Key="B.Border"      Color="#D3D8DE"/>
  <SolidColorBrush x:Key="B.Text"        Color="#15181C"/>
  <SolidColorBrush x:Key="B.Muted"       Color="#5C6670"/>
  <SolidColorBrush x:Key="B.Accent"      Color="#F2B01E"/>
  <SolidColorBrush x:Key="B.AccentHover" Color="#E0A00C"/>
  <SolidColorBrush x:Key="B.AccentSoft"  Color="#FFF0C4"/>
  <SolidColorBrush x:Key="B.AccentInk"   Color="#8A5B00"/>
  <SolidColorBrush x:Key="B.OnAccent"    Color="#15181C"/>
  <SolidColorBrush x:Key="B.Danger"      Color="#B3261E"/>
  <SolidColorBrush x:Key="B.DangerSoft"  Color="#FBE9E7"/>
  <SolidColorBrush x:Key="B.Success"     Color="#1B7F4D"/>
  <SolidColorBrush x:Key="B.SuccessSoft" Color="#E2F3EA"/>
  <SolidColorBrush x:Key="B.Warn"        Color="#8A5B00"/>
  <SolidColorBrush x:Key="B.WarnSoft"    Color="#FFF0C4"/>
  <SolidColorBrush x:Key="B.Hover"       Color="#E4E8EC"/>
  <SolidColorBrush x:Key="B.Film"        Color="#1A1C20"/>
  <SolidColorBrush x:Key="B.FilmHole"    Color="#E8EBEE"/>
  <SolidColorBrush x:Key="B.FilmFrame"   Color="#33373D"/>

  <!-- make the stock WPF templates (ListBox, ComboBox, ScrollViewer...) follow the palette -->
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"                  Color="#FFFFFF"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}"              Color="#15181C"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"                 Color="#F0F2F4"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}"             Color="#15181C"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"               Color="#FFF0C4"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"           Color="#15181C"/>
</ResourceDictionary>
